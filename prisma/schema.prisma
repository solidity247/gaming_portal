generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model InternalUser {
  id            Int     @id @default(autoincrement())
  userId        String  @unique @map("user_id")
  balance       Int     @default(0)
  currentGameId Int?    @map("current_game_id")
  currentGame   Game?   @relation("UserCurrentGame", fields: [currentGameId], references: [id])

  gamesAsPlayer1 Game[] @relation("Player1")
  gamesAsPlayer2 Game[] @relation("Player2")

  @@map("internal_users")
}

model Game {
  id            Int       @id @default(autoincrement())
  player1Id     String    @map("player1_id")
  player2Id     String    @map("player2_id")
  gameType      String    @default("bg") @map("game_type")
  status        String
  actionTimeMs  Int       @default(10000) @map("action_time_ms")
  reserveTimeMs Int       @default(45000) @map("reserve_time_ms")
  doubleDecisionTimeMs Int @default(10000) @map("double_decision_time_ms")
  initialBetAmount Int    @default(10) @map("initial_bet_amount")
  currentBetAmount Int    @default(10) @map("current_bet_amount")
  bankAmount    Int       @default(20) @map("bank_amount")
  payoutPercent Int       @default(80) @map("payout_percent")
  payoutAmount  Int?      @map("payout_amount")
  initialRoll   String?
  winnerId      String?   @map("winner_id")
  engineMatchId String?   @unique @map("engine_match_id")
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  rolls        Roll[]
  rematchOffer GameRematchOffer?
  currentUsers InternalUser[] @relation("UserCurrentGame")
  player1      InternalUser   @relation("Player1", fields: [player1Id], references: [userId])
  player2      InternalUser   @relation("Player2", fields: [player2Id], references: [userId])

  @@map("games")
}

model Roll {
  id               Int      @id @default(autoincrement())
  gameId           Int
  boardStateBefore String
  dice             Int[]
  actions          String
  boardStateAfter  String
  timestamp        DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id])

  @@map("rolls")
}

model MatchmakingQueue {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id")
  gameType  String   @default("bg") @map("game_type")
  actionTimeMs Int   @default(10000) @map("action_time_ms")
  reserveTimeMs Int  @default(45000) @map("reserve_time_ms")
  doubleDecisionTimeMs Int @default(10000) @map("double_decision_time_ms")
  initialBetAmount Int @default(10) @map("initial_bet_amount")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("matchmaking_queue")
}

model GameRematchOffer {
  id              Int      @id @default(autoincrement())
  gameId          Int      @unique @map("game_id")
  requesterUserId String   @map("requester_user_id")
  responderUserId String   @map("responder_user_id")
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id])

  @@index([requesterUserId, status], map: "game_rematch_offers_requester_status_idx")
  @@index([responderUserId, status], map: "game_rematch_offers_responder_status_idx")
  @@map("game_rematch_offers")
}
